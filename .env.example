# Runtime environment: development, staging, or production
AIR_AGENTS_ENV=development

# Use a durable volume in production; Docker Compose mounts ./data for local use.
AIR_AGENTS_DATABASE_PATH=./data/air_agents.db

# Only explicitly enable on a host with persistent storage.
AIR_AGENTS_ENABLE_PUBLIC_INTAKE=true

# JSON mapping of API secret to role. Generate strong, unique values and never commit them.
# Roles: viewer (read), operator (read/write), admin (read/write/audit access)
AIR_AGENTS_API_KEYS={"replace-with-a-long-random-admin-secret":"admin","replace-with-a-long-random-operator-secret":"operator","replace-with-a-long-random-viewer-secret":"viewer"}

# Comma-separated browser origins permitted to call this API.
AIR_AGENTS_CORS_ORIGINS=https://airagentsllc.co,https://www.airagentsllc.co

# GitHub webhook secret configured in the GitHub App/webhook settings. Generate
# a unique high-entropy value; keep it only in the API host's encrypted secrets.
AIR_AGENTS_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-github-webhook-secret
